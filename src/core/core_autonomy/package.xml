<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>core_autonomy</name>
  <version>1.0.0</version>
  <description>
    Gateway keepalive, safety-gated command relay, and monitoring for the
    BlueBoat backseat.
  </description>
  <maintainer email="bluelab@icm.csic.es">BLUE Lab, ICM-CSIC</maintainer>
  <license>MIT</license>
  <url type="repository">https://github.com/BlueLab-ICM/blueboat-core-public</url>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>core_interfaces</depend>

  <exec_depend>python3-psutil</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
