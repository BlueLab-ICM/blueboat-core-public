FROM ros:jazzy-ros-base

RUN apt-get update && apt-get install -y \
    ros-jazzy-foxglove-bridge \
    ros-jazzy-vision-msgs \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app/backseat_ws
COPY src/interfaces/core_interfaces/ src/interfaces/core_interfaces/
RUN /bin/bash -c "source /opt/ros/jazzy/setup.bash && colcon build"

CMD ["/bin/bash", "-c", "source /opt/ros/jazzy/setup.bash && source install/setup.bash && ros2 run foxglove_bridge foxglove_bridge --ros-args -p port:=8765 --log-level warn"]
