# Values for one vehicle. Copy to vehicle.local.env (untracked) and fill in.
# Sourced by vehicle.env, which documents every key and its default.
# Values stay empty until filled, so the scripts' unset checks still fire.

# This vehicle's name: data goes to ~/deployments-<name>, and hardware_id uses it.
: "${VEHICLE_NAME:=}"

# DDS domain for this boat, unique per boat and not 0 (SITL laptops use 0).
: "${ROS_DOMAIN_ID:=}"
