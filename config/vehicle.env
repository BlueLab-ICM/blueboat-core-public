# Vehicle identity — single source of truth for per-boat names and paths.
#
# Each vehicle sets VEHICLE_NAME in vehicle.local.env. Everything that builds a
# per-vehicle path derives from it. start-mission.sh refuses a real mission as "unnamed".
#
# Lab-internal values (modem IP, WiFi names, hotspot credentials) go in the
# untracked vehicle.local.env next to this file (template: vehicle.local.env.example),
# in the same ': "${VAR:=value}"' form so an exported variable still wins.

_vehicle_local="$(dirname "${BASH_SOURCE[0]}")/vehicle.local.env"
# shellcheck source=/dev/null
[[ -f "$_vehicle_local" ]] && source "$_vehicle_local"
unset _vehicle_local

: "${VEHICLE_NAME:=unnamed}"

# Root folder for all deployment/mission output for this vehicle.
: "${DEPLOY_DATA_ROOT:=$HOME/deployments-${VEHICLE_NAME}}"

# Backseat board, as reported in diagnostics and used to pick payload compose files.
if [[ -z "${BACKSEAT_PLATFORM:-}" ]]; then
    [[ -f /etc/nv_tegra_release ]] && BACKSEAT_PLATFORM="jetson" || BACKSEAT_PLATFORM="rpi"
fi

# DDS domain: each boat its own, so ROS 2 traffic from another boat or a SITL laptop
# (default 0) never reaches it. 0-101 on Linux. Set in vehicle.local.env.
: "${ROS_DOMAIN_ID:=0}"

# Vehicle ethernet segment. Defaults are the BlueOS standard addresses.
: "${FRONTSEAT_IP:=192.168.2.2}"
: "${BACKSEAT_IP:=192.168.2.5}"
: "${BASESTATION_GW:=192.168.2.1}"
: "${MAVLINK2REST_URL:=http://${FRONTSEAT_IP}/mavlink2rest}"

# Backseat network interfaces. Defaults are the Jetson Orin Nano names.
: "${ETH_IFACE:=enP8p1s0}"
: "${WIFI_IFACE:=wlP1p1s0}"

# Other vehicles to exchange positions with: host or host:port, separated by spaces.
: "${FLEET_PEERS:=}"
: "${FLEET_PORT:=14660}"

# Docker log driver. journald survives a compose down and a power cut; set json-file on a host
# without systemd.
: "${DOCKER_LOG_DRIVER:=journald}"

export VEHICLE_NAME DEPLOY_DATA_ROOT BACKSEAT_PLATFORM ROS_DOMAIN_ID \
    FLEET_PEERS FLEET_PORT DOCKER_LOG_DRIVER \
    FRONTSEAT_IP BACKSEAT_IP BASESTATION_GW MAVLINK2REST_URL \
    ETH_IFACE WIFI_IFACE
